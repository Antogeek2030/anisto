---
import Layout from '../../layouts/Layout.astro';
const phone = '+12565550199';
const phoneDisplay = '(256) 555-0199';
---
<Layout title="Roof Leaks | Professional Leak Detection Anniston AL" description="Experiencing roof leaks in Anniston? Get a professional leak detection inspection to find the source and stop damage.">
  <section class="hero" style="padding:4rem 0 3rem">
    <div class="container">
      <div class="hero-badge">URGENT</div>
      <h1>Roof <span>Leaks</span></h1>
      <p class="hero-desc">Water stains, active drips, or musty odors mean moisture is getting in. Locating the source quickly limits interior damage and mold risk.</p>
      <a href={`tel:${phone}`} class="btn btn-primary">Schedule Leak Detection</a>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p style="max-width:700px;margin:0 auto;color:var(--text-muted)">Leaks often appear far from the actual entry point. Our inspections check flashing, valleys, penetrations, and attic conditions to identify likely sources and recommend targeted repairs.</p>
    </div>
  </section>
  <section class="section section-alt" style="text-align:center">
    <div class="container"><a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay}</a></div>
  </section>
</Layout>
