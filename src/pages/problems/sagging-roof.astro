---
import Layout from '../../layouts/Layout.astro';
const phone = '+12565550199';
const phoneDisplay = '(256) 555-0199';
---
<Layout title="Sagging Roof Inspection Anniston AL" description="Sagging roof in Anniston? Schedule a professional inspection to assess structural concerns and recommend next steps.">
  <section class="hero" style="padding:4rem 0 3rem">
    <div class="container">
      <div class="hero-badge">ADDRESS SOON</div>
      <h1>Sagging <span>Roof</span></h1>
      <p class="hero-desc">Visible sagging can indicate water-damaged decking, structural issues, or overloaded areas. A professional assessment is important.</p>
      <a href={`tel:${phone}`} class="btn btn-primary">Schedule Inspection</a>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p style="max-width:700px;margin:0 auto;color:var(--text-muted)">We evaluate the roof surface, attic (when accessible), and related structure for signs of moisture, compromised decking, or other contributing factors, and provide clear recommendations.</p>
    </div>
  </section>
  <section class="section section-alt" style="text-align:center">
    <div class="container"><a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay}</a></div>
  </section>
</Layout>
