---
import Layout from '../../layouts/Layout.astro';
const phone = '+12565550199';
const phoneDisplay = '(256) 555-0199';
---
<Layout title="Gutter Issues | Roof System Inspection Anniston" description="Gutter problems affecting your roof or foundation in Anniston? Include gutters in a professional roof system inspection.">
  <section class="hero" style="padding:4rem 0 3rem">
    <div class="container">
      <div class="hero-badge">ADDRESS SOON</div>
      <h1>Gutter <span>Issues</span></h1>
      <p class="hero-desc">Clogged, damaged, or poorly pitched gutters can cause water backup, fascia damage, and foundation problems.</p>
      <a href={`tel:${phone}`} class="btn btn-primary">Schedule Inspection</a>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p style="max-width:700px;margin:0 auto;color:var(--text-muted)">Our roof inspections include a review of the gutter system as part of the overall water management evaluation, with notes on condition and recommended maintenance.</p>
    </div>
  </section>
  <section class="section section-alt" style="text-align:center">
    <div class="container"><a href={`tel:${phone}`} class="btn btn-primary">Call {phoneDisplay}</a></div>
  </section>
</Layout>
